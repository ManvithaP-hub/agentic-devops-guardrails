# ─────────────────────────────────────────────────────────────────────────────
# agentic-devops-guardrails — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# AWS Bedrock Guardrail (required)
# Find this in AWS Console → Bedrock → Guardrails → your guardrail → Guardrail ID
BEDROCK_GUARDRAIL_ID=<your-guardrail-id>
BEDROCK_GUARDRAIL_VERSION=1

# AWS Region (defaults to us-east-1 if not set)
AWS_REGION=us-east-1

# DynamoDB table for HITL approvals (defaults to devops-agent-approvals)
DYNAMODB_TABLE_NAME=devops-agent-approvals

# CloudWatch log group for pipeline audit (defaults to /devops-agent/pipeline-audit)
CLOUDWATCH_LOG_GROUP=/devops-agent/pipeline-audit

# SNS topic ARN for HITL approval notifications (used by Terraform module)
# SNS_APPROVAL_TOPIC_ARN=arn:aws:sns:<region>:<account-id>:<topic-name>
